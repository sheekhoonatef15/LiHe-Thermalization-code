Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"This is a mean-temperature kinetic model, not a 5,000-particle \
trajectory simulation. \"\>", 
   "\[InvisibleSpace]", "\<\"The Li-He cross section is illustrative and must \
be replaced with a measured/calculated \"\>", 
   "\[InvisibleSpace]", "\<\"temperature-dependent transport cross section \
for quantitative predictions. \"\>", 
   "\[InvisibleSpace]", "\<\"The collision-rate approximation includes drift \
speed, but the energy-relaxation \"\>", 
   "\[InvisibleSpace]", "\<\"equation does not model directed-flow energy \
conversion, spatial diffusion, \"\>", 
   "\[InvisibleSpace]", "\<\"Li-Li collision kinetics, wall collisions, or \
non-Maxwellian velocity distributions. \"\>", 
   "\[InvisibleSpace]", "\<\"A constant He temperature and density are \
assumed throughout the cooling region.\"\>"}],
  SequenceForm[
  "This is a mean-temperature kinetic model, not a 5,000-particle trajectory \
simulation. ", 
   "The Li-He cross section is illustrative and must be replaced with a \
measured/calculated ", 
   "temperature-dependent transport cross section for quantitative \
predictions. ", 
   "The collision-rate approximation includes drift speed, but the \
energy-relaxation ", 
   "equation does not model directed-flow energy conversion, spatial \
diffusion, ", 
   "Li-Li collision kinetics, wall collisions, or non-Maxwellian velocity \
distributions. ", 
   "A constant He temperature and density are assumed throughout the cooling \
region."],
  Editable->False]], "Print",
 CellChangeTimes->{4.000850697968466*^9, 4.0008508051263275`*^9, 
  4.0008508525407486`*^9},
